<?xml version="1.0"?>
<ruleset name="tldr-block">
    <description>PSR-12 for the plugin code and tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>tldr-block.php</file>
    <file>autoload.php</file>
    <file>uninstall.php</file>
    <file>examples</file>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <!-- WordPress hooks name some callbacks in snake case. -->
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="220"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
    <!-- The main file and loaders declare symbols and have side effects by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tldr-block.php</exclude-pattern>
        <exclude-pattern>autoload.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
    </rule>
</ruleset>
