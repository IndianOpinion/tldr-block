{
    "name": "indianopinion/tldr-block",
    "description": "WordPress plugin: a short, editor-approved summary block at the top of long posts, regenerated when the post changes, with a shortcode, a block and per-category switches.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "summary", "tldr", "block", "llm", "editorial"],
    "homepage": "https://github.com/IndianOpinion/tldr-block",
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org"
        }
    ],
    "support": {
        "issues": "https://github.com/IndianOpinion/tldr-block/issues",
        "source": "https://github.com/IndianOpinion/tldr-block"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\TldrBlock\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\TldrBlock\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
